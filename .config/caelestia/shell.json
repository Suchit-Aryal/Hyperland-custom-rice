{
    "appearance": {
        "transparency": {
            "enabled": true
        }
    },
    "background": {
        "enabled": true,
        "wallpaperEnabled": true
    },
    "bar": {
        "activeWindow": {
            "compact": true,
            "inverted": false
        },
        "clock": {
            "background": false,
            "showDate": true
        },
        "persistent": false,
        "popouts": {
            "statusIcons": true,
            "tray": true
        },
        "scrollActions": {
            "brightness": true,
            "workspaces": true
        },
        "showOnHover": false,
        "statusIcons": [
            {
                "enabled": false,
                "id": "lockStatus"
            },
            {
                "enabled": false,
                "id": "audio"
            },
            {
                "enabled": false,
                "id": "microphone"
            },
            {
                "enabled": false,
                "id": "kbLayout"
            },
            {
                "enabled": true,
                "id": "network"
            },
            {
                "enabled": true,
                "id": "bluetooth"
            },
            {
                "enabled": true,
                "id": "battery"
            }
        ],
        "tray": {
            "background": false,
            "compact": true,
            "recolour": false
        },
        "workspaces": {
            "activeIndicator": true,
            "activeTrail": false,
            "maxWindowIcons": 5,
            "occupiedBg": false,
            "perMonitorWorkspaces": true,
            "showWindows": true,
            "showWindowsOnSpecialWorkspaces": true,
            "shown": 5
        }
    },
    "dashboard": {
        "performance": {
            "showNetwork": true
        }
    },
    "enabled": true,
    "general": {
        "apps": {
            "terminal": [
                "kitty"
            ]
        },
        "showOverFullscreen": false
    },
    "launcher": {
        "showOnHover": false,
        "useFuzzy": {
            "apps": true,
            "wallpapers": true
        }
    },
    "paths": {
        "wallpaperDir": "~/Pictures/Wallpapers"
    },
    "services": {
        "useFahrenheit": false
    },
    "session": {
        "commands": {
            "hibernate": [
                "systemctl",
                "suspend"
            ]
        },
        "icons": {
            "hibernate": "bedtime"
        }
    },
    "sidebar": {
        "dragThreshold": 100,
        "enabled": true
    }
}
