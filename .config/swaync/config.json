{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "cssPriority": "user",

  "control-center-width": 400,
  "control-center-height": 860,
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 0,

  "notification-window-width": 350,
  "notification-icon-size": 48,
  "notification-body-image-height": 180,
  "notification-body-image-width": 180,
  "notification-2fa-action": true,

  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,

  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "scripts": {},
  "notification-visibility": {
    "example-name": {
      "state": "muted",
      "urgency": "Low",
      "app-name": "Spotify"
    }
  },
  "widgets": [
    "title",
    "buttons-grid",
    "dnd",
    "mpris",
    "volume",
    "backlight",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "󰆴 Clear"
    },
    "dnd": {
      "text": "Do Not Disturb",
      "do-not-disturb-on-startup": false,
      "do-not-disturb": false
    },
    "mpris": {
      "image-size": 96,
      "image-radius": 14,
      "show-album-art": "playing",
      "blacklist": [
        "firefox",
        "chromium",
        "brave",
        "mpv",
        "playerctl"
      ],
      "autohide": true,
      "prefer": ["spotify"]
    },
    "volume": {
      "label": "󰕾 ",
      "show-per-app": false
    },
    "backlight": {
      "label": "󰃠 ",
      "device": "nvidia_wmi_ec_backlight",
      "subsystem": "backlight",
      "min": 10
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰤨  Internet",
          "command": "swaync-client -cp -sw; ~/.config/rofi/launchers/wifi.sh"
        },
        {
          "label": "󰂯  Bluetooth",
          "command": "swaync-client -cp -sw; ~/.config/rofi/launchers/rofi-bluetooth"
        },
        {
          "label": "󰖔  Night light",
          "command": "if command -v hyprsunset >/dev/null; then ~/.config/hypr/scripts/Hyprsunset.sh toggle; else notify-send -u low 'Night light' 'hyprsunset is not installed'; fi"
        },
        {
          "label": "󰄀  Screenshot",
          "command": "swaync-client -cp -sw; ~/.config/hypr/scripts/ScreenShot.sh --area"
        },
        {
          "label": "󰸉  Wallpaper",
          "command": "swaync-client -cp -sw; ~/.config/hypr/UserScripts/WallpaperSelect.sh"
        },
        {
          "label": "󰕾  Sound",
          "command": "swaync-client -cp -sw; ~/.config/hypr/scripts/toggle-sound-popup.sh"
        },
        {
          "label": "󰚈",
          "command": "swaync-client -cp -sw; pavucontrol"
        },
        {
          "label": "󰌾",
          "command": "swaync-client -cp -sw; ~/.config/hypr/scripts/LockScreen.sh"
        },
        {
          "label": "⏻",
          "command": "swaync-client -cp -sw; ~/.config/hypr/scripts/Wlogout.sh"
        }
      ]
    }
  }
}
